<% layout("/layouts/boilerplate") %>
    <script>
        const mapToken = "<%= mapToken %>";
        const listing = JSON.parse('<%- JSON.stringify(listing) %>');
    </script>
    <div class="row">
        <div class="col-8 offset-3 mt-3">
            <h3 class="mb-0">
                <%= listing.title %>
            </h3>
        </div>
        <div class="card listing-card col-6 offset-3 show-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text">Owned by:
                    <b><i>
                            <%= listing.owner.username %>
                        </i></b>
                </p>
                <p class="card-text">
                    <%=listing.description %> <br>
                        <p class="card-text"> &#8377; <%=listing.price.toLocaleString("en-IN") %> </p>
                        <p class="card-text">
                            <%=listing.location %>
                        </p>
                        <p class="card-text">
                            <%=listing.country %>
                        </p>
                </p>
            </div>
        </div>
        <% if(currUser && listing.owner._id.toString()===currUser._id.toString()) { %>
            <div class="btns">
                <a class="btn btn-dark col-1 edit-btn offset-3 rent-btn" href="/listing/<%=listing._id %>/edit">Edit</a>
                <form action="/listing/<%=listing._id %>?_method=DELETE" method="post">
                    <button class="btn btn-dark offset-5">
                        Delete
                    </button>
                    <br><br>
                </form>
            </div>
            <% } %>
                <div class="col-8 mt-3 mb-3 offset-3 ">
                    <% if(currUser ) {%>
                        <h4>Leave a Rating</h4>
                        <form action="/listing/<%= listing._id %>/reviews" method="POST" novalidate
                            class="needs-validation">
                            <!-- <label class="form-label" for="rating">Rating</label> -->
                            <!-- <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]"> -->
                            <fieldset class="starability-slot">
                                <legend>Rating:</legend>
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                            <br>
                            <label class="form-label" for="comment">Give your Experience</label>
                            <textarea class="form-control" name="review[comment]" rows="5" cols="30" id="comment"
                                required></textarea>
                            <div class="invalid-feedback">Please add some comments</div>
                            <div class="valid-feedback">Thank you for your comments</div>
                            <br>
                            <button class="btn btn-outline-dark rev-btn">
                                Submit
                            </button>
                        </form>
                        <% } %>
                            <% if(listing.reviews.length> 0) { %>
                                <hr>
                                <h4>All Reviews</h4>
                                <div class="row">
                                    <% for(let review of listing.reviews) { %>
                                        <div class="card col-5 ms-3 mb-3">
                                            <div class="card-body">
                                                <div class="card-title">
                                                    <b>
                                                        <%= review.author.username %>
                                                    </b>
                                                </div>

                                                <p class="starability-result card-text"
                                                    data-rating="<%= review.rating %>"></p>

                                                <p class="card-text">
                                                    <%= review.comment %>
                                                </p>

                                                <% if (currUser && review.author._id.equals(currUser._id)) { %>
                                                    <form class="mb-3"
                                                        action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                        method="post">
                                                        <button class="btn btn-sm btn-dark">Delete</button>
                                                    </form>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>
                                <% } %>

                                    <div class="col-6 mt-3 mb-3 ">
                                        <h3>where you will be</h3>
                                        <div id="map">
                                        </div>
                                    </div>
                </div>
    </div>
    <script src="/js/map.js"></script>