<% layout("/layouts/boilerplate") %>
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter {
            opacity: 0.7;
            text-align: center;
            margin-top: 2rem;
            margin-right: 2.2rem;
        }

        .filter:hover {
            opacity: 1;
        }

        .filter p {
            font-size: 13px;
        }

        .icon {
            font-size: 20px;
        }

        .tax-info {
            display: none;
        }
        .switches{
            border: 1px solid black;
            border-radius: 1rem;
            height: 3.2rem;
            display: flex;
            align-items: center;
            padding: 1rem;
            margin-left: 5rem;
            margin-top: 1rem;
        }
    </style>
    <div id="filters">
        <div class="filter">
            <div class="icon"><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-solid fa-building-wheat"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div class="icon"><i class="fa-regular fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
         <div class="filter">
            <div class="icon"><i class="fa-solid fa-landmark-dome"></i></div>
            <p>Dome</p>
        </div>
         <div class="filter">
            <div class="icon"><i class="fa-solid fa-ship"></i></div>
            <p>Boats</p>
        </div>

        <div class="switches">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Show total after taxes</label>
            </div>
        </div>
    </div>
    <h1>All Listing</h1>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for(let listing of allListing){%>
            <a href="/listing/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <div class="card-text">
                            <b>
                                <%= listing.title %>
                            </b>
                            <br>
                            &#8377; <%=listing.price.toLocaleString("en-IN") %> /night
                                <div class="tax-info">
                                    &nbsp; &nbsp; +18% GST
                                </div>
                        </div>
                    </div>
                </div>
            </a>
            <% } %>

                <script>
                    let taxSwitch = document.getElementById("switchCheckDefault");
                    taxSwitch.addEventListener("click", () => {
                        let taxinfo = document.getElementsByClassName("tax-info");
                        for (info of taxinfo) {
                            if (info.style.display !== "inline") {
                                info.style.display = "inline";
                            } else {
                                info.style.display = "none";
                            }
                        }

                    })
                </script>